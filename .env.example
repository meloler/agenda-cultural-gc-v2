TM_API_KEY=pon_tu_clave_aqui
DATABASE_URL=postgresql://usuario:password@localhost:5432/agenda_cultural

# Supabase para frontend Next.js: claves públicas seguras solamente.
# No pongas service role aquí con prefijo NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Credenciales de Supabase para pipeline local/servidor, nunca frontend.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica
SUPABASE_SERVICE_ROLE_KEY=solo_servidor_pipeline_nunca_frontend

# Clasificador de eventos (opcional)
# Modo: "local" (default, keywords) o "llm" (requiere API key)
CLASSIFIER_MODE=local
GEMINI_API_KEY=
OPENAI_API_KEY=
